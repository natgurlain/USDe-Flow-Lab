# Production observations by default. Set mock only for an explicit demo deployment.
USDE_DATA_PROVIDER=defillama

# Optional durable verified snapshots. Apply sql/schema.sql before enabling.
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
# CRON_SECRET=replace-with-a-long-random-secret

# Preview deployments never use DATABASE_URL; provide a separate database if needed.
# PREVIEW_DATABASE_URL=postgres://user:password@preview-host:5432/database?sslmode=require

# Optional reliable Ethereum mainnet RPC with archive eth_call, finalized blocks,
# and eth_getLogs support for about 7,200 blocks. Server only; never NEXT_PUBLIC_.
# Defaults: dRPC for vault reads, PublicNode for issuer events.
# ETHEREUM_RPC_URL=https://your-provider.example/your-server-only-key
